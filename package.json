{
  "name": "badger",
  "version": "0.0.0",
  "private": true,
  "description": "Expose localhost through secure public URLs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm build:tsc && pnpm --filter @hridhin-k/badger-dashboard build",
    "build:tsc": "tsc -b",
    "typecheck": "tsc -b --noEmit && pnpm --filter @hridhin-k/badger-dashboard typecheck",
    "clean": "tsc -b --clean && pnpm --filter @hridhin-k/badger-dashboard clean",
    "lint": "eslint . && pnpm --filter @hridhin-k/badger-dashboard lint",
    "lint:fix": "eslint . --fix && pnpm --filter @hridhin-k/badger-dashboard lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cli": "node ./apps/cli/dist/index.js",
    "server:dev": "pnpm --filter @hridhin-k/badger-server dev",
    "server:start": "pnpm --filter @hridhin-k/badger-server start",
    "dashboard:dev": "pnpm --filter @hridhin-k/badger-dashboard dev",
    "dashboard:build": "pnpm --filter @hridhin-k/badger-dashboard build",
    "dashboard:start": "pnpm --filter @hridhin-k/badger-dashboard start",
    "test": "pnpm --filter @hridhin-k/badger-shared --filter @hridhin-k/badger-server --filter @hridhin-k/badger --filter @hridhin-k/badger-dashboard test",
    "test:e2e": "pnpm build:tsc && pnpm --filter @hridhin-k/badger-e2e test",
    "publish:cli": "pnpm build:tsc && pnpm --filter @hridhin-k/badger-shared publish && pnpm --filter @hridhin-k/badger publish"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
