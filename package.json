{
  "name": "badger",
  "version": "0.0.0",
  "private": true,
  "description": "Expose localhost through secure public URLs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "clean": "tsc -b --clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cli": "node ./apps/cli/dist/index.js",
    "server:dev": "pnpm --filter @badger/server dev",
    "server:start": "pnpm --filter @badger/server start",
    "test": "pnpm --filter @badger/shared --filter @badger/server --filter @badger/cli test",
    "test:e2e": "pnpm build && pnpm --filter @badger/e2e test",
    "publish:cli": "pnpm build && pnpm --filter @badger/shared publish && pnpm --filter @badger/cli publish"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
