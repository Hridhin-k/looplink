{
  "name": "badger",
  "version": "0.0.0",
  "private": true,
  "description": "Expose localhost through secure public URLs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "clean": "tsc -b --clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cli": "node ./apps/cli/dist/index.js",
    "server:dev": "pnpm --filter @hridhin-k/badger-server dev",
    "server:start": "pnpm --filter @hridhin-k/badger-server start",
    "test": "pnpm --filter @hridhin-k/badger-shared --filter @hridhin-k/badger-server --filter @hridhin-k/badger-cli test",
    "test:e2e": "pnpm build && pnpm --filter @hridhin-k/badger-e2e test",
    "publish:cli": "pnpm build && pnpm --filter @hridhin-k/badger-shared publish && pnpm --filter @hridhin-k/badger-cli publish",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
