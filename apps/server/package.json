{
  "name": "@hridhin-k/badger-server",
  "version": "0.0.0",
  "private": true,
  "description": "Badger tunnel server that relays public traffic to local clients.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean",
