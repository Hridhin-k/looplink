# Badger Dashboard environment
#
# The dashboard is a standalone Next.js app. It talks to the Badger server only
# through public REST and WebSocket endpoints — never by importing server code.
#
# Copy to `.env.local` for local development:
#   cp apps/dashboard/.env.example apps/dashboard/.env.local

# Public HTTP base URL of the Badger tunnel server (no trailing slash).
NEXT_PUBLIC_BADGER_API_URL=http://localhost:8080

# Public WebSocket base URL of the Badger tunnel server (no trailing slash).
# Must point at the same host/port that serves the server's WebSocket API.
NEXT_PUBLIC_BADGER_WS_URL=ws://localhost:8080
