{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "looplink",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "looplink",
    },
  ],
  // Add custom domain only after `wybrand.in` is a zone on this Cloudflare
  // account (Workers → looplink → Domains, or uncomment below and redeploy):
  // "routes": [{ "pattern": "dashboard.wybrand.in", "custom_domain": true }],
}
