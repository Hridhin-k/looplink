{
  "name": "@hridhin-k/badger-cli",
  "version": "1.1.0",
  "description": "Expose localhost through a secure public URL with Badger.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hridhin-k/looplink.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/Hridhin-k/looplink/tree/main/apps/cli#readme",
  "bugs": {
    "url": "https://github.com/Hridhin-k/looplink/issues"
  },
  "keywords": [
    "badger",
    "looplink",
    "tunnel",
    "localhost",
    "ngrok",
    "cli",
    "devtools"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
