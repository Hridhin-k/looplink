{
  "name": "@looplink/cli",
  "version": "0.0.0",
  "private": true,
  "description": "LoopLink command-line client for exposing localhost through secure public URLs.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "looplink": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "dev": "node ./dist/index.js",
    "start": "node ./dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@looplink/shared": "workspace:*",
    "chalk": "^5.6.2",
    "clipboardy": "^5.3.2",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "qrcode-terminal": "^0.12.0",
    "undici": "^8.9.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "vitest": "^4.1.10"
  }
}
