# Badger environment variables
#
# For local server development, prefer `.env.local` at the repo root (gitignored).
# The server loads `.env.local` then `.env` on startup; shell-exported vars win.
#
# Copy this file for compose host-port overrides, or set variables in your shell.
# Container runtime values live in:
#   docker/development.env
#   docker/production.env
#
# See docker/README.md for the full ports reference.

# =============================================================================
# Ports
# =============================================================================
#
# Badger uses a SINGLE TCP port for everything on the server:
#
# | Port | Protocol              | Direction | Purpose                                      |
# |------|-----------------------|-----------|----------------------------------------------|
# | 8080 | TCP (HTTP)            | inbound   | GET /health                                  |
# | 8080 | TCP (HTTP)            | inbound   | Public tunnel traffic (Host-based routing)   |
# | 8080 | TCP (HTTP Upgrade/WS) | inbound   | CLI control plane (CREATE_TUNNEL, heartbeat) |
#
# The CLI on a developer machine connects with:
#   badger <port> --server ws://<docker-host>:8080
#
# Host publish mapping (compose): `${PORT:-8080}:8080`
#   - Left  (host):      override with PORT in this file / the environment
#   - Right (container): always 8080 unless you edit docker-compose.yml

# Host port published to the machine running Docker Compose (maps to container 8080).
PORT=8080

# =============================================================================
# Server listen (inside the container / process)
# =============================================================================

# Bind address. Use 0.0.0.0 in Docker. Defaults to 0.0.0.0 when unset.
# HOST=0.0.0.0

# Container / process listen port. Defaults to 8080 when unset.
# Must stay aligned with the compose container port (8080).
# PORT=8080

# =============================================================================
# Public tunnel URLs
# =============================================================================

# Public hostname (no scheme) used when minting tunnel URLs.
# Path mode:   https://{domain}/tunnel/{tunnelId}   (Railway / single-host TLS)
# Subdomain:   https://{slug}.{domain}              (wildcard DNS + cert)
# Default when unset: badger.dev
# BADGER_PUBLIC_BASE_DOMAIN=badger.dev
#
# On Railway, set this to your service domain, e.g.:
# BADGER_PUBLIC_BASE_DOMAIN=looplinkserver-production.up.railway.app

# How public URLs are minted. Default: path (Railway-compatible).
# Set to "subdomain" for classic wildcard deployments behind nginx.
# BADGER_PUBLIC_URL_MODE=path
# BADGER_PUBLIC_URL_MODE=subdomain
#
# Deprecated LoopLink aliases (still honored; BADGER_* wins if both are set):
# LOOPLINK_PUBLIC_BASE_DOMAIN=...
# LOOPLINK_PUBLIC_URL_MODE=path|subdomain
# See docs/migration.md.

# =============================================================================
# HTTP forwarding
# =============================================================================

# Max wait (ms) for the CLI to answer a forwarded request. Default: 30000
# BADGER_HTTP_FORWARD_TIMEOUT_MS=30000

# =============================================================================
# Security
# =============================================================================

# Comma-separated browser Origins allowed to call the public HTTP API.
# Empty (default) = permissive. CLI clients omit Origin and are always allowed.
# BADGER_ALLOWED_ORIGINS=https://badger.dev

# Max public HTTP body size in bytes (Fastify bodyLimit). Default: 5242880 (5 MiB)
# BADGER_MAX_HTTP_BODY_BYTES=5242880

# Max WebSocket frame size from CLI clients. Default: 262144 (256 KiB)
# BADGER_MAX_WS_MESSAGE_BYTES=262144

# Max concurrent WebSocket connections. Default: 1000
# BADGER_MAX_WS_CONNECTIONS=1000

# Max WebSocket connections per client IP. Default: 50
# BADGER_MAX_WS_CONNECTIONS_PER_IP=50

# CLI control-plane messages allowed per IP per window (create/ping/invalid).
# HTTP response frames are not counted. Default: 120
# BADGER_WS_MESSAGE_RATE_LIMIT=120
# BADGER_WS_MESSAGE_RATE_WINDOW_MS=60000

# Public HTTP requests allowed per IP per window. Default: 2000
# BADGER_HTTP_RATE_LIMIT_MAX=2000
# BADGER_HTTP_RATE_LIMIT_WINDOW_MS=60000

# Fastify request timeout (headers + body) in ms. Default: 30000
# BADGER_HTTP_REQUEST_TIMEOUT_MS=30000

# =============================================================================
# Supabase (Phase 3 — optional for tunnel-only)
# =============================================================================
#
# When unset, the server boots without a database (Phases 1–2 behavior).
# When any one is set, all three are required and validated at startup.
# Connectivity is verified on boot when enabled.
#
# Local stack (after `pnpm db:start`):
#   SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_ANON_KEY=<anon key from `supabase status`>
#   SUPABASE_SERVICE_ROLE_KEY=<service_role key from `supabase status`>
#
# Prefer the legacy JWT keys from Project Settings → API (anon / service_role).
# The newer sb_publishable_ / sb_secret_ keys may not work with supabase-js Auth.
#
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================================================
# Runtime / image
# =============================================================================

# NODE_ENV=production

# Image tag used by docker-compose.prod.yml (default: latest)
# BADGER_IMAGE_TAG=latest
# https://looplinkserver-production.up.railway.app/