# Badger server — production defaults for Docker Compose.
# Loaded by docker-compose.prod.yml. Prefer secrets managers for anything sensitive;
# this file intentionally contains no credentials.

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------
# Container listen port. Must match the right-hand side of the compose mapping
# `${PORT:-8080}:8080` (the container side is fixed at 8080 in docker-compose.yml).
PORT=8080

# Bind address inside the container.
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Public URL generation
# ---------------------------------------------------------------------------
# Public DNS suffix for tunnel URLs: https://{slug}.{BADGER_PUBLIC_BASE_DOMAIN}
# Set this to your real tunnel domain before going live.
BADGER_PUBLIC_BASE_DOMAIN=badger.dev

# ---------------------------------------------------------------------------
# HTTP forwarding
# ---------------------------------------------------------------------------
BADGER_HTTP_FORWARD_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=production
