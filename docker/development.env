# Badger server — development defaults for Docker Compose.
# Loaded by docker-compose.dev.yml. Override any value in a local .env if needed.

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------
# PORT (container listen port) must stay 8080 to match the compose port mapping
# `${PORT:-8080}:8080` host side uses the host's PORT from the shell/.env;
# inside the container we always bind 8080 unless you also change the mapping.
PORT=8080

# Bind address inside the container. Always 0.0.0.0 in Docker so published
# ports are reachable from the host and other containers.
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Public URL generation
# ---------------------------------------------------------------------------
# DNS suffix used when minting tunnel URLs: https://{slug}.{BADGER_PUBLIC_BASE_DOMAIN}
# For local development, point this at a domain (or /etc/hosts) you control.
BADGER_PUBLIC_BASE_DOMAIN=localhost

# ---------------------------------------------------------------------------
# HTTP forwarding
# ---------------------------------------------------------------------------
# How long the server waits for the CLI to answer a forwarded HTTP request (ms).
BADGER_HTTP_FORWARD_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
